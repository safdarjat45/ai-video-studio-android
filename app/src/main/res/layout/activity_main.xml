<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A">

    <!-- Top Native App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1E293B"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎬 AI Video Studio"
            android:textColor="#F8FAFC"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnGoogleFlow"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:text="Google Flow"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnChangeServer"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Server URL"
            android:textColor="#10B981"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Server Setup Overlay Panel (Shown on first launch or when changing Colab/PC URL) -->
    <LinearLayout
        android:id="@+id/setupPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚀 Connect Studio Engine"
            android:textColor="#10B981"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Google Colab Notebook (colab_mobile_studio_server.ipynb) chala kar wahan milne wala trycloudflare.com URL neeche paste karein:"
            android:textColor="#CBD5E1"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etServerUrl"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="#1E293B"
            android:hint="https://xxxx.trycloudflare.com"
            android:inputType="textUri"
            android:paddingHorizontal="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#10B981"
            android:text="Open AI Video Studio Dashboard"
            android:textColor="#0F172A"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:visibility="gone" />

    <!-- Main Interactive Dashboard WebView with File Upload & MP4 Download Support -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
